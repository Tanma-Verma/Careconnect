# Google Gemini OpenAI-compatible endpoints. Copy to .env; put your real key only there.
EMBEDDING_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
EMBEDDING_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001
LLM_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
# The same Gemini API key can be supplied for both server-side key variables.
# Gemini 3.5 Flash-Lite is the selected demo model after a verified latency comparison.
# No alternative model is selected silently if generation fails.
# gemini-embedding-001 uses its default 3072 dimensions; do not truncate vectors.
# Base URLs include the provider's version prefix (usually /v1), without endpoint.
# Separate keys/base URLs permit different embedding and generation providers.
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
SESSION_HOURS=12
# Per-provider failure allowance; the retry shares the remaining budget.
PROVIDER_TIMEOUT_SECONDS=120
# Cosine distance: smaller is closer. Calibrate using your demo documents.
MAX_COSINE_DISTANCE=0.65
# Existing PostgreSQL service credentials; override URL if it was configured differently.
DATABASE_URL=postgresql://careconnect:careconnect@postgres:5432/careconnect

# Synthetic ERP data only. Disabled by default; pass true explicitly to seed/index commands.
DEMO_SEED_ENABLED=false
# Local-only demo account password (12–128 characters). Never commit a populated value.
DEMO_PASSWORD=
